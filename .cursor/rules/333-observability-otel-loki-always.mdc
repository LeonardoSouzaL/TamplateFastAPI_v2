# core/logging_config.py

Criar uma configuração de logging reutilizável.

O `core/logging_config.py` também é responsável por garantir que todo log
enviado ao Loki tenha a label `level`.

Essa label é obrigatória para que a política de retenção do Loki consiga manter
erros por 7 dias e logs comuns por 24h.

Usar este modelo como base:

```python
import importlib.util
import logging
import logging.config
from queue import Queue

from core.config import settings

LOG_FORMAT = (
    "%(asctime)s %(levelname)s "
    "[%(name)s] "
    "[%(filename)s:%(lineno)d] "
    "[trace_id=%(otelTraceID)s "
    "span_id=%(otelSpanID)s "
    "resource.service.name=%(otelServiceName)s] "
    "- %(message)s"
)


class LokiLevelTagFilter(logging.Filter):
    """Adiciona a label level em cada registro enviado ao Loki.

    O Loki aplica retention_stream por labels, não pelo texto da mensagem.
    Portanto, para manter erros por 7 dias, cada log precisa chegar com
    level=error ou level=critical quando aplicável.
    """

    def filter(self, record: logging.LogRecord) -> bool:
        current_tags = getattr(record, "tags", {}) or {}

        record.tags = {
            **current_tags,
            "level": record.levelname.lower(),
        }

        return True


def _loki_disponivel() -> bool:
    return importlib.util.find_spec("logging_loki") is not None


def _loki_tags() -> dict:
    return {
        "app": settings.loki_app_name,
        "host": settings.loki_host_name,
        "env": settings.OTEL_ENVIRONMENT,
    }


def _build_loki_handler_config(log_level: str) -> dict:
    base = {
        "level": log_level,
        "url": settings.LOKI_URL,
        "tags": _loki_tags(),
        "filters": ["loki_level_tag"],
        "auth": None,
        "version": "1",
    }
    if settings.LOKI_ASYNC:
        return {
            **base,
            "class": "logging_loki.LokiQueueHandler",
            "queue": Queue(-1),
        }
    return {
        **base,
        "class": "logging_loki.LokiHandler",
    }


def get_logging_config() -> dict:
    log_level = settings.LOG_LEVEL

    handlers = {
        "default": {
            "level": log_level,
            "formatter": "standard",
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stdout",
        }
    }

    root_handlers = ["default"]

    if settings.LOKI_ENABLED and _loki_disponivel():
        handlers["loki"] = _build_loki_handler_config(log_level)
        root_handlers.append("loki")

    config = {
        "version": 1,
        "disable_existing_loggers": False,
        "formatters": {
            "standard": {"format": LOG_FORMAT},
        },
        "handlers": handlers,
        "loggers": {
            "": {
                "handlers": root_handlers,
                "level": log_level,
                "propagate": False,
            },
            "uvicorn": {
                "handlers": root_handlers,
                "level": log_level,
                "propagate": False,
            },
            "uvicorn.access": {
                "handlers": root_handlers,
                "level": log_level,
                "propagate": False,
            },
            "uvicorn.error": {
                "handlers": root_handlers,
                "level": log_level,
                "propagate": False,
            },
        },
    }

    if settings.LOKI_ENABLED and _loki_disponivel():
        config["filters"] = {
            "loki_level_tag": {
                "()": LokiLevelTagFilter,
            },
        }

    return config


def setup_logging() -> None:
    logging.config.dictConfig(get_logging_config())
```

Nunca usar comentário inválido dentro de dicionário Python.

Errado:

```python
"app": "Nome aplicacao", -- mudar
```

Correto:

```python
"app": settings.loki_app_name,  # valor vindo do config
```

Errado para retenção:

```python
"tags": {
    "app": settings.loki_app_name,
    "host": settings.loki_host_name,
    "env": settings.OTEL_ENVIRONMENT,
}
```

Correto para retenção (assíncrono — padrão):

```python
"class": "logging_loki.LokiQueueHandler",
"queue": Queue(-1),
"tags": {
    "app": settings.loki_app_name,
    "host": settings.loki_host_name,
    "env": settings.OTEL_ENVIRONMENT,
},
"filters": ["loki_level_tag"],
```

Correto para retenção (síncrono — apenas quando `LOKI_ASYNC=False`):

```python
"class": "logging_loki.LokiHandler",
"tags": {
    "app": settings.loki_app_name,
    "host": settings.loki_host_name,
    "env": settings.OTEL_ENVIRONMENT,
},
"filters": ["loki_level_tag"],
```

A label `level` não deve ser fixa dentro de `tags`, porque cada registro pode ter
um nível diferente. Ela deve ser adicionada dinamicamente pelo filtro
`LokiLevelTagFilter`.

